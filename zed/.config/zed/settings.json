{
  "autosave": "on_focus_change",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "172.233.20.66",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root"],
        },
        {
          "paths": ["/root/dev"],
        },
      ],
    },
    {
      "host": "172.233.20.66",
      "username": "root",
      "args": [],
      "projects": [],
    },
    {
      "host": "172.233.20.66",
      "username": "root",
      "args": [],
      "projects": [],
    },
  ],
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "kimi": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "effort": "max",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "max",
      },
    ],
    "model_parameters": [],
  },
  "helix_mode": false,
  "vim_mode": false,
  "toolbar": {
    "code_actions": false,
  },
  "centered_layout": {
    "right_padding": 0.05,
    "left_padding": 0.05,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "buffer_font_family": "Fira Code",
  "ui_font_size": 18,
  "buffer_font_size": 16,
  "buffer_font_weight": 600,
  "buffer_font_features": {
    "calt": true,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-"],
        },
      },
    },
  },
}

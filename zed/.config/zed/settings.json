  "agent_servers": {
    "kimi": {
      "default_mode": "default",
      "type": "registry",
    },
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "normas.leg.br",
        "www.lexml.gov.br",
        "www.camara.leg.br",
        "pesquisa.in.gov.br"
      ]
    },
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^/home/h/dev/JA-LandingPage/src/routes/assinar/\\[plano\\]/"
            }
          ]
        },
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "effort": "max",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "max",
      },
    ],
    "model_parameters": [],
  },
  "helix_mode": false,
  "vim_mode": false,
  "toolbar": {
    "code_actions": false,
  },
  "centered_layout": {
    "right_padding": 0.05,
    "left_padding": 0.05,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "buffer_font_family": "Fira Code",
  "ui_font_size": 18,
  "buffer_font_size": 16,
  "buffer_font_weight": 600,
  "buffer_font_features": {
    "calt": true,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvblur - blurred",
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-"],
        },
      },
    },
  },
}
